{
  "name": "jelly-lab-chain-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "assets": "node scripts/derive-assets.mjs",
    "balance": "node scripts/balance.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.yaml *.html README.md docs",
    "format:check": "prettier --check src tests scripts *.ts *.json *.yaml *.html README.md docs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.34.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
